# Copia este archivo como ".env" (en la raíz del proyecto, junto a package.json)
# y llena cada valor con los datos de TU proyecto de Firebase.
#
# Dónde encontrarlos:
# Firebase Console -> (ícono de engrane) Configuración del proyecto
#   -> pestaña "General" -> sección "Tus apps"
#   -> si no tienes una app Web (</>) registrada, créala ahí mismo
#   -> ahí aparece un bloque "firebaseConfig" con estos mismos nombres
#
# IMPORTANTE: el archivo ".env" real NUNCA se sube a git (ya está en .gitignore).
# Este .env.example sí se sube, como plantilla, pero sin valores reales.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
